    "workday": {
      "platform_name": "Workday",
      "description": "Enterprise cloud HCM platform. Strict keyword matching, strong section parsing, rejects non-standard formatting.",
      "keyword_matching": {
        "mode": "exact_and_synonym",
        "case_sensitive": false,
        "requires_exact_job_title_match": true,
        "penalizes_keyword_stuffing": true,
        "keyword_stuffing_threshold": 5
      },
      "section_requirements": {
        "required": ["summary", "experience", "education", "skills"],
        "recommended": ["certifications", "projects"],
        "strict_section_headers": true
      },
      "contact_requirements": {
        "required_fields": ["name", "email", "phone"],
        "recommended_fields": ["location", "linkedin"],
        "validates_email_format": true,
        "validates_phone_format": true
      },
      "formatting_risks": {
        "rejects_tables": true,
        "rejects_columns": true,
        "rejects_headers_footers": true,
        "rejects_images": true,
        "rejects_text_boxes": true,
        "max_file_size_mb": 5,
        "accepted_formats": ["pdf", "docx"]
      },
      "date_parsing": {
        "strictness": "strict",
        "accepted_formats": ["MM/YYYY", "Month YYYY", "YYYY"],
        "flags_future_dates": true,
        "flags_gaps_over_months": 6
      },
      "experience_evaluation": {
        "values_recency": true,
        "recency_window_years": 5,
        "values_role_title_match": true,
        "min_bullet_points_per_role": 2
      },
      "scoring_weight_overrides": {
        "required_keywords": 0.30,
        "required_skills": 0.30,
        "preferred_keywords": 0.10,
        "sections": 0.15,
        "contact": 0.05,
        "length": 0.10
      }
    },
